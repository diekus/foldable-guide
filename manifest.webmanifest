{
  "id": "./",
  "name": "Foldable Guide · Posture Inspector",
  "short_name": "Foldable Guide",
  "description": "A framework-free PWA boilerplate for foldable devices, demonstrating the Device Posture API and the Viewport Segments API.",
  "lang": "en",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "theme_color": "#ffffff",
  "background_color": "#f6f6ff",
  "categories": ["developer", "education", "utilities"],
  "icons": [
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
